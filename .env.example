# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR & INTEGRAÇÃO REDIS CLOUD + GOOGLE FORMS
# FECAP - Big Data 2026
# ==============================================================================

# Porta do Servidor Local / Cloud
PORT=3000

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS REDIS CLOUD (https://cloud.redis.io/)
# ------------------------------------------------------------------------------
# Chave de API ou Senha fornecida no painel do Redis Cloud
REDIS_API_KEY=sua_chave_api_aqui
REDIS_PASSWORD=sua_senha_do_banco_aqui

# Endereço do Endpoint Público do seu banco no Redis Cloud:
# Exemplo: redis-12345.c250.sa-east-1-1.ec2.redns.redis-cloud.com
REDIS_HOST=

# Porta do seu banco no Redis Cloud (ex: 12345):
REDIS_PORT=

# Nome de usuário padrão do Redis (geralmente 'default')
REDIS_USERNAME=default

# Ou Connection String completa (se preferir uma única linha):
# Exemplo: redis://default:sua_senha@redis-12345.c250.sa-east-1-1.ec2.redns.redis-cloud.com:12345
REDIS_URL=

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO COM PLANILHA GOOGLE SHEETS / FORMS
# ------------------------------------------------------------------------------
# Para sincronizar automaticamente via Google Sheets publicado como CSV:
# No Google Sheets: Arquivo > Compartilhar > Publicar na Web > Escolha a aba > Formato: CSV (.csv) > Publicar
# Cole a URL gerada abaixo:
GOOGLE_SHEET_CSV_URL=

# Token de segurança para webhook do Google Apps Script
WEBHOOK_SECRET=fecap-bigdata-secret-2026
